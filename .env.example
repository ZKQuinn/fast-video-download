# Local development
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-me-for-local-development

# Agent showcase mode. Set true for stable demo data without real downloads.
AGENT_DEMO_MODE=true

# Optional LLM planner configuration. Leave empty to use rule-based fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional Stripe configuration. Required only for real payment testing.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Bilibili cookie file, relative paths are resolved by backend/downloader.py.
BILIBILI_COOKIE_FILE=
